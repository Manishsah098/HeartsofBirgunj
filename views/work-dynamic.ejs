<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Work | Hearts of Birgunj</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/jpeg" href="/assets/logo.jpg">
</head>

<body>

    <div class="back-btn-container">
        <button onclick="window.history.back()" class="btn btn-back">
            <i class="fa-solid fa-arrow-left"></i> <span>Go Back</span>
        </button>
    </div>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <img src="/assets/logo.jpg" alt="Hearts of Birgunj" class="logo-img">
                <span class="logo-text">हार्ट्स अफ वीरगन्ज<br><span style="font-size:0.8rem;font-weight:500;opacity:0.85">Hearts of Birgunj</span></span>
            </a>
            <div class="nav-links">
                <a href="/about.html">About Us</a>
                <a href="/work.html" class="active">Our Work</a>
                <a href="/members.html">Our Members</a>
                <a href="/impact.html">Our Impact</a>
                <a href="/projects.html">Projects</a>
                <a href="/contact.html">Contact</a>
            </div>
            <div class="nav-actions">
                <a href="/admin/login" class="btn btn-outline">Login</a>
                <a href="/donate.html" class="btn btn-primary">Support Us</a>
                <button class="mobile-menu-btn"><i class="fa-solid fa-bars"></i></button>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <header class="page-header">
        <div class="container">
            <h1 class="page-title">Our Work — हाम्रा कार्यहरू</h1>
            <p>Hearts of Birgunj ले वीरगञ्ज तथा आसपासका क्षेत्रमा सञ्चालन गर्ने मुख्य कार्यक्षेत्रहरू तथा सामाजिक गतिविधिहरू।</p>
        </div>
    </header>

    <!-- Areas of Work (कार्यक्षेत्रहरू) -->
    <section class="section" style="padding: 6rem 0;" id="work-areas">
        <div class="container">
            <div class="text-center" style="margin-bottom: 4rem;">
                <span class="section-subtitle">What We Do</span>
                <h2 style="font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: 0.8rem;">कार्यक्षेत्रहरू <br><span style="font-size: 1.35rem; color: #64748b; font-weight: normal;">(Areas of Work)</span></h2>
                <p style="color: #64748b; font-size: 1.1rem; max-width: 600px; margin: 0 auto;">Hearts of Birgunj का प्रमुख ६ कार्यक्षेत्रहरू</p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
                <!-- Card 1 -->
                <div class="work-area-card" style="border-left-color: #e11d48;">
                    <h4 style="color: #e11d48;"><i class="fa-solid fa-hand-holding-heart"></i> क. सामाजिक सेवा तथा मानव सहयोग</h4>
                    <ul>
                        <li>गरिब तथा विपन्न परिवारलाई खाद्यान्न र आवश्यक सामग्री वितरण।</li>
                        <li>असहाय तथा ज्येष्ठ नागरिकलाई सहयोग।</li>
                        <li>चाडपर्व तथा विशेष अवसरमा सेवा कार्यक्रम।</li>
                        <li>आपत्कालीन राहत तथा उद्धार कार्यमा सहयोग।</li>
                    </ul>
                </div>

                <!-- Card 2 -->
                <div class="work-area-card" style="border-left-color: #16a34a;">
                    <h4 style="color: #16a34a;"><i class="fa-solid fa-heart-pulse"></i> ख. स्वास्थ्य तथा सरसफाइ</h4>
                    <ul>
                        <li>निःशुल्क स्वास्थ्य शिविर सञ्चालनमा सहयोग।</li>
                        <li>रक्तदान कार्यक्रम तथा रक्तदाता सञ्जाल निर्माण।</li>
                        <li>प्राथमिक उपचार तथा स्वास्थ्य सचेतना कार्यक्रम।</li>
                        <li>सार्वजनिक स्थानमा सरसफाइ अभियान।</li>
                        <li>गर्मी तथा भीडभाडका समयमा निःशुल्क पानी तथा शरबत वितरण।</li>
                    </ul>
                </div>

                <!-- Card 3 -->
                <div class="work-area-card" style="border-left-color: #7c3aed;">
                    <h4 style="color: #7c3aed;"><i class="fa-solid fa-graduation-cap"></i> ग. शिक्षा तथा युवा विकास</h4>
                    <ul>
                        <li>विद्यार्थीहरूलाई शैक्षिक सामग्री वितरण।</li>
                        <li>शैक्षिक जनचेतना कार्यक्रम।</li>
                        <li>युवा नेतृत्व तथा व्यक्तित्व विकास तालिम।</li>
                        <li>विद्यार्थी तथा युवाहरूका लागि प्रेरणादायी कार्यक्रम।</li>
                        <li>प्रतिभाशाली तथा आर्थिक रूपमा कमजोर विद्यार्थीलाई सहयोग।</li>
                    </ul>
                </div>

                <!-- Card 4 -->
                <div class="work-area-card" style="border-left-color: #d97706;">
                    <h4 style="color: #d97706;"><i class="fa-solid fa-leaf"></i> घ. वातावरण संरक्षण</h4>
                    <ul>
                        <li>वृक्षारोपण कार्यक्रम।</li>
                        <li>प्लास्टिक न्यूनीकरण अभियान।</li>
                        <li>वातावरण तथा सरसफाइसम्बन्धी जनचेतना।</li>
                        <li>स्वच्छ र हरित वीरगञ्ज अभियान।</li>
                    </ul>
                </div>

                <!-- Card 5 -->
                <div class="work-area-card" style="border-left-color: #e11d48;">
                    <h4 style="color: #e11d48;"><i class="fa-solid fa-music"></i> ङ. कला, संस्कृति तथा मनोरञ्जन</h4>
                    <ul>
                        <li>स्थानीय कला तथा संस्कृतिको संरक्षण।</li>
                        <li>सांस्कृतिक कार्यक्रम तथा महोत्सव आयोजना।</li>
                        <li>युवा प्रतिभा पहिचान तथा प्रोत्साहन।</li>
                        <li>नृत्य, संगीत, खेलकुद तथा सिर्जनात्मक प्रतियोगिता।</li>
                        <li>सामाजिक एकता तथा सद्भाव बढाउने कार्यक्रम।</li>
                    </ul>
                </div>

                <!-- Card 6 -->
                <div class="work-area-card" style="border-left-color: #dc2626;">
                    <h4 style="color: #dc2626;"><i class="fa-solid fa-triangle-exclamation"></i> च. विपद् तथा आपत्कालीन सहयोग</h4>
                    <ul>
                        <li>आगलागी, बाढी, दुर्घटना तथा अन्य विपद्मा सहयोग।</li>
                        <li>राहत सामग्री संकलन तथा वितरण।</li>
                        <li>स्वयंसेवक परिचालन।</li>
                        <li>प्राथमिक उपचार तथा आपत्कालीन सहयोग।</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <% if (typeof works !== 'undefined' && works.length > 0) { %>
    <!-- Additional Initiatives Section -->
    <section class="section work-section bg-light" id="initiatives" style="padding: 5rem 0 7rem;">
        <div class="container text-center">
            <span class="section-subtitle">Programs &amp; Projects</span>
            <h2 class="section-title">हाम्रा थप <span class="highlight">पहलहरू</span></h2>

            <div class="work-grid mt-5">
                <% works.forEach(work => { %>
                <div class="work-card">
                    <div class="work-icon"><i class="<%= work.icon || 'fa-solid fa-users' %>"></i></div>
                    <h3><%= work.title %></h3>
                    <p><%= work.subtitle %></p>
                    <a href="/news/<%= work.id %>" class="work-link">Learn More <i class="fa-solid fa-chevron-right"></i></a>
                </div>
                <% }) %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Footer -->
    <footer class="footer" id="contact-footer">
        <div class="container footer-grid">
            <div class="footer-about">
                <a href="/" class="logo footer-logo">
                    <img src="/assets/logo.jpg" alt="Hearts of Birgunj" class="logo-img">
                </a>
                <p>Hearts of Birgunj is dedicated to inspiring change, transforming lives, and fostering resilient
                    communities through active youth participation.</p>
                <div class="social-links">
                    <a href="https://facebook.com/" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="https://instagram.com/" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-instagram"></i></a>
                    <a href="mailto:heartsofbirgunj@gmail.com" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-envelope"></i></a>
                    <a href="https://youtube.com/" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>

            <div class="footer-links">
                <h3>Our Work</h3>
                <ul>
                    <li><a href="/work.html">सामाजिक सेवा तथा मानव सहयोग</a></li>
                    <li><a href="/work.html">स्वास्थ्य तथा सरसफाइ</a></li>
                    <li><a href="/work.html">शिक्षा तथा युवा विकास</a></li>
                    <li><a href="/work.html">वातावरण संरक्षण</a></li>
                </ul>
            </div>

            <div class="footer-links">
                <h3>Quick Links</h3>
                <ul>
                    <li><a href="/about.html">About Us</a></li>
                    <li><a href="/about.html#history">Our History</a></li>
                    <li><a href="/projects.html">Impact Stories</a></li>
                    <li><a href="/donate.html">Support Us</a></li>
                    <li><a href="/contact.html">Contact Us</a></li>
                </ul>
            </div>

            <div class="footer-contact">
                <h3>Contact</h3>
                <p><i class="fa-solid fa-map-pin"></i> Birgunj Mahanagarpalika, Parsa, Nepal</p>
                <p><i class="fa-solid fa-phone"></i> +977-9763368173</p>
                <p><i class="fa-solid fa-envelope"></i> heartsofbirgunj@gmail.com</p>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p>&copy; 2025 Hearts of Birgunj. All Rights Reserved. Serving Humanity, Inspiring Hope.</p>
            </div>
        </div>
    </footer>

    <script src="script.js"></script>
</body>

</html>
