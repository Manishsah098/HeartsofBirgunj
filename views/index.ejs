<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>हार्ट्स अफ वीरगन्ज | Hearts of Birgunj</title>
    <link rel="icon" type="image/jpeg" href="/assets/logo.jpg">
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Homepage mobile responsive overrides */
        @media (max-width: 768px) {
            /* Hero section overrides */
            .hero {
                padding-top: 100px !important;
                align-items: flex-start !important;
            }
            .hero-content.glass-card {
                padding: 2rem 1.5rem !important;
                margin-top: 20px !important;
            }
            .hero-content .hero-title:first-child {
                font-size: 1.8rem !important;
            }
            .hero-content .hero-title:nth-child(2) {
                font-size: 1.5rem !important;
            }
            .hero-content .hero-description {
                font-size: 1rem !important;
                margin-bottom: 1.5rem !important;
            }
            
            .vision-mission-section {
                flex-direction: column !important;
                min-height: auto !important;
            }
            .vision-mission-section > div {
                flex: 1 1 100% !important;
                min-width: 100% !important;
                padding: 3rem 6% !important;
            }
            .vision-mission-section h2 {
                font-size: 2rem !important;
            }
            .vision-mission-section p {
                font-size: 1rem !important;
            }
            /* Stats pill */
            .stats-pill-section {
                margin-top: -60px !important;
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }
            .stats-pill-section > div {
                border-radius: 30px !important;
                border-width: 8px !important;
                padding: 2rem 1.5rem !important;
                gap: 1.5rem !important;
            }
            .stats-pill-section .stat-number {
                font-size: 2.5rem !important;
            }
            /* Organizational identity section */
            .identity-section {
                min-height: auto !important;
                padding: 2rem 0 !important;
                flex-direction: column !important;
            }
            .identity-section > div:first-child {
                position: relative !important;
                width: 100% !important;
                height: 300px !important;
            }
            .identity-section > div:nth-child(2) {
                width: 95% !important;
                max-width: 100% !important;
                padding: 2rem !important;
                border-radius: 0 20px 20px 0 !important;
                margin-top: -30px !important;
            }
            .identity-section > div:nth-child(2) h2 {
                font-size: 2rem !important;
            }
            .identity-section > div:nth-child(2) p {
                font-size: 1.05rem !important;
            }
            /* Careers section */
            .section#careers > .container > div {
                padding: 2rem !important;
                flex-direction: column !important;
            }
            .section#careers h2 {
                font-size: 2rem !important;
            }
            /* News title row */
            .news-section .container > div:first-child h2 {
                font-size: 1.6rem !important;
            }
            /* Testimonial header */
            .testimonials-section .text-center h2 {
                font-size: 2.2rem !important;
            }
        }
        @media (max-width: 480px) {
            .vision-mission-section > div {
                padding: 2rem 5% !important;
            }
            .vision-mission-section h2 {
                font-size: 1.6rem !important;
                gap: 0.8rem !important;
            }
            .vision-mission-section h2 i {
                font-size: 1.8rem !important;
            }
            .stats-pill-section > div {
                padding: 1.5rem 1rem !important;
                border-width: 5px !important;
                border-radius: 24px !important;
            }
            .stats-pill-section .stat-number {
                font-size: 2rem !important;
            }
            .identity-section > div:nth-child(2) h2 {
                font-size: 1.6rem !important;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <img src="/assets/logo.jpg" alt="Hearts of Birgunj" class="logo-img">
                <span class="logo-text">हार्ट्स अफ वीरगन्ज<br><span style="font-size:0.8rem;font-weight:500;opacity:0.85">Hearts of Birgunj</span></span>
            </a>
            <div class="nav-links">
                <a href="/about.html">About Us</a>
                <a href="/work.html">Our Work</a>
                <a href="/members.html">Our Members</a>
                <a href="/impact.html">Our Impact</a>
                <a href="/projects.html">Projects</a>
                <a href="/contact.html">Contact</a>
            </div>
            <div class="nav-actions">
                <a href="/admin/login" class="btn btn-outline">Login</a>
                <a href="/donate.html" class="btn btn-primary">Support Us</a>
                <button class="mobile-menu-btn"><i class="fa-solid fa-bars"></i></button>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero" id="home" style="background-image: url('/assets/background.jpg');">
        <!-- The background image will be set via CSS -->
        <div class="hero-overlay"></div>
        <div class="hero-content glass-card" style="max-width: 620px; margin: 0; text-align: left; padding: 2.8rem;">
            <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(225, 29, 72, 0.15); border: 1px solid rgba(225, 29, 72, 0.3); padding: 0.35rem 1rem; border-radius: 50px; font-size: 0.82rem; font-weight: 600; color: #fecdd3; margin-bottom: 1.2rem; letter-spacing: 0.5px;">
                <i class="fa-solid fa-heart" style="color: #e11d48;"></i> Hearts of Birgunj • सेवा नै धर्म हो
            </div>
            <h1 class="hero-title" style="margin-bottom: 0.4rem; font-size: clamp(2rem, 3.2vw, 2.7rem); color: #fecdd3; text-shadow: 0 4px 15px rgba(225, 29, 72, 0.4); line-height: 1.25;">मानवताको सेवा, समाजको परिवर्तन</h1>
            <h2 class="hero-title" style="font-size: clamp(1.4rem, 2.2vw, 1.85rem); margin-top: 0; margin-bottom: 1.2rem; line-height: 1.3; color: #ffffff;">Serving Humanity,<br>Inspiring Hope.</h2>
            <p class="hero-description" style="max-width: 540px; margin: 0 0 2rem 0; font-size: 1.05rem; line-height: 1.7; color: rgba(255, 255, 255, 0.85);">Hearts of Birgunj — वीरगञ्जमा सामाजिक सेवा, मानवता र सकारात्मक परिवर्तनको संस्था। हामी विश्वास गर्छौँ कि सानो कदमले पनि ठूलो परिवर्तन ल्याउन सक्छ।</p>
            <div class="hero-buttons" style="justify-content: flex-start; gap: 1rem;">
                <a href="work.html" class="btn btn-primary btn-lg btn-pulse">Explore Our Work</a>
                <a href="impact.html" class="btn btn-outline btn-lg" style="border-color: rgba(255,255,255,0.4); background: rgba(0,0,0,0.25);">See Our Impact</a>
            </div>
        </div>
        <div class="scroll-indicator">
            <div class="mouse">
                <div class="wheel"></div>
            </div>
        </div>
    </header>
    <!-- Vision, Mission & Impact Section -->
    <section class="vision-mission-cards">
        <div class="vm-card">
            <h2 style="font-size: 2.5rem; display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; color: #111827; font-family: var(--font-heading);">
                <i class="fa-solid fa-bullseye" style="color: var(--primary); font-size: 2.2rem;"></i> 
                <div>हाम्रो अभियान<br><span style="font-size: 1.2rem; color: #64748b;">Our Mission</span></div>
            </h2>
            <p style="font-size: 1.15rem; line-height: 1.8; color: #475569; font-weight: 500;">
                समाजका हरेक वर्ग र समुदायका मानिसहरूलाई एकताबद्ध गर्दै सेवा, सहयोग, जनचेतना तथा सामाजिक विकासका कार्यक्रममार्फत सकारात्मक परिवर्तन ल्याउनु।
            </p>
        </div>
        
        <div class="vm-card">
            <h2 style="font-size: 2.5rem; display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; color: #111827; font-family: var(--font-heading);">
                <i class="fa-solid fa-eye" style="color: var(--accent); font-size: 2.2rem;"></i> 
                <div>हाम्रो दृष्टि<br><span style="font-size: 1.2rem; color: #64748b;">Our Vision</span></div>
            </h2>
            <p style="font-size: 1.15rem; line-height: 1.8; color: #475569; font-weight: 500;">
                मानवता, एकता, सहयोग र सकारात्मक सोचमा आधारित समावेशी, शिक्षित, स्वस्थ तथा सहयोगी समाजको निर्माण गर्नु।
            </p>
        </div>
        
        <div class="vm-card" style="display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 2.5rem;">
            <div style="width: 140px; height: 140px; border-radius: 50%; overflow: hidden; box-shadow: 0 10px 30px rgba(225,29,72,0.25); border: 4px solid #fff; background: url('assets/education.png') center/cover; margin-bottom: 1.5rem;">
            </div>
            <h2 style="font-size: 2rem; font-weight: 800; color: #111827; margin-bottom: 1rem; font-family: var(--font-heading);">Our Impact</h2>
            <p style="font-size: 1rem; line-height: 1.7; color: #475569; margin-bottom: 1.5rem;">
                Hearts of Birgunj ले वीरगञ्ज र आसपासका क्षेत्रमा सामाजिक सेवा, स्वास्थ्य, शिक्षा र वातावरण संरक्षणका कार्यक्रमहरू सञ्चालन गर्दै आएको छ।
            </p>
            <a href="impact.html" class="btn" style="background: var(--gradient-primary); color: #ffffff; padding: 0.8rem 2.2rem; border-radius: 30px; font-weight: 700; text-transform: uppercase; box-shadow: 0 4px 15px rgba(225, 29, 72, 0.35);">READ MORE</a>
        </div>
    </section>

    <!-- Stats Pill Section -->
    <section class="stats-pill-section relative z-10 -mt-[120px] px-8 flex justify-center">
        <div
            class="glass-pill rounded-[40px] py-14 px-16 flex justify-around flex-wrap gap-8 w-full max-w-[1100px] text-center shadow-[0_10px_40px_rgba(0,0,0,0.12)]">

            <div class="flex-1 min-w-[180px]">
                <h3 class="stat-number text-[#fb7185] text-6xl font-extrabold mb-2 leading-none" data-target="2"
                    style="font-family: var(--font-heading);">
                    0</h3>
                <p class="text-[#F8FAFC] font-bold text-[0.95rem] tracking-[1px] uppercase">
                    Experience Years</p>
            </div>

            <div class="flex-1 min-w-[180px]">
                <h3 class="stat-number text-[#fb7185] text-6xl font-extrabold mb-2 leading-none" data-target="10"
                    style="font-family: var(--font-heading);">
                    0</h3>
                <p class="text-[#F8FAFC] font-bold text-[0.95rem] tracking-[1px] uppercase leading-relaxed">
                    Programs and<br>Projects</p>
                <span class="text-rose-300 text-sm block mt-2">Ongoing...</span>
            </div>

            <div class="flex-1 min-w-[180px]">
                <h3 class="stat-number text-[#fb7185] text-6xl font-extrabold mb-2 leading-none" data-target="6"
                    style="font-family: var(--font-heading);">
                    0</h3>
                <p class="text-[#F8FAFC] font-bold text-[0.95rem] tracking-[1px] uppercase">
                    District Reaches</p>
            </div>

            <div class="flex-1 min-w-[180px]">
                <h3 class="stat-number text-[#fb7185] text-6xl font-extrabold mb-2 leading-none" data-target="5"
                    style="font-family: var(--font-heading);">
                    0</h3>
                <p class="text-[#F8FAFC] font-bold text-[0.95rem] tracking-[1px] uppercase leading-relaxed">
                    Accreditations and<br>Awards</p>
            </div>

        </div>
    </section>

    <!-- News and Updates Section -->
    <section class="section news-section" id="news"
        style="padding-top: 8rem; padding-bottom: 6rem; background-color: #ffffff;">
        <div class="container">
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 3rem;">
                <h2
                    style="font-size: 2.2rem; font-weight: 700; font-family: var(--font-heading); color: #1E293B; margin: 0;">
                    समाचार र अपडेटहरू <span style="font-size: 1.2rem; color: #64748b; font-weight: normal;">(News and Updates)</span></h2>
                <a href="projects.html"
                    style="width: 45px; height: 45px; border-radius: 50%; border: 2px solid var(--primary); display: flex; align-items: center; justify-content: center; color: var(--primary); text-decoration: none; font-size: 1.2rem; transition: all 0.3s;"
                    onmouseover="this.style.background='var(--primary)'; this.style.color='#fff';"
                    onmouseout="this.style.background='transparent'; this.style.color='var(--primary)';">
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <div class="news-grid-v2">
                <% posts.forEach(post => { %>
                <div class="news-card-v2">
                    <a href="/news/<%= post.id %>" class="news-card-image-wrap">
                        <% if (post.image_url) { %>
                            <img src="/<%= post.image_url %>" alt="<%= post.title %>">
                        <% } else { %>
                            <div style="background: #e2e8f0; height: 200px; display: flex; align-items: center; justify-content: center; color: #94a3b8;">
                                <i class="fa-solid fa-newspaper" style="font-size: 3rem;"></i>
                            </div>
                        <% } %>
                    </a>
                    <h3><%= post.title %></h3>
                    <a href="/news/<%= post.id %>" class="btn-read-more">READ MORE</a>
                </div>
                <% }) %>
                <% if (posts.length === 0) { %>
                    <p style="grid-column: span 3; text-align: center; color: var(--text-muted);">No news or updates available.</p>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials-section">
        <div class="container">
            <div class="text-center" style="margin-bottom: 6rem;">
                <span class="section-subtitle">Testimonials</span>
                <h2
                    style="font-size: 3.5rem; font-family: var(--font-heading); font-weight: 800; color: #1E293B; line-height: 1.1;">
                    हाम्रो संस्थाको लागि<br>उत्कृष्ट सन्देशहरू <br><span style="font-size: 1.5rem; color: #64748b; font-weight: 600;">(Awesome messages for our organization)</span></h2>
            </div>

            <div class="testimonial-grid" style="display: flex; justify-content: center;">
                <!-- Deepak Kumar Sonar - Founder Message -->
                <div class="testimonial-card" style="max-width: 780px; width: 100%;">
                    <div class="testimonial-avatar-wrap">
                        <div class="testimonial-avatar">
                            <img src="/assets/deepal.jpg" alt="Deepak Kumar Sonar"
                                style="width: 100%; height: 100%; object-fit: cover; object-position: center top;">
                        </div>
                    </div>
                    <h3 class="testimonial-name">Deepak Kumar Sonar</h3>
                    <span class="testimonial-role">Founder President / संस्थापक अध्यक्ष, Hearts of Birgunj</span>
                    <p class="testimonial-text">"हाम्रो संस्थाको मूलमा मानवतापूर्ण सेवा र सामाजिक न्यायप्रतिको प्रतिबद्धता छ। गरिब र विपन्न परिवारलाई सहयोग गर्नदेखि युवाहरूलाई सशक्त बनाउनसम्म, हाम्रो लक्ष्य एउटै छ — वीरगञ्जलाई अझ सभ्य, सहयोगी र विकसित बनाउनु। हामी मात्र कार्यक्रम सञ्चालन गर्दैनौं; हामी एउटा परिवर्तनको आन्दोलन सुरु गर्दैछौं।"</p>
                    <a href="about.html" class="btn-more">ABOUT OUR STORY</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Organizational Identity Section -->
    <section class="identity-section" id="identity"
        style="position: relative; width: 100%; min-height: 550px; padding: 4rem 0; background-color: #f8fafc; display: flex; align-items: center; overflow: hidden;">
        <!-- Right side background image block -->
        <div style="position: absolute; right: 0; top: 0; width: 75%; height: 100%;">
            <img src="/assets/student-studying.jpg" alt="Student Studying - Hearts of Birgunj Education Mission"
                style="width: 100%; height: 100%; object-fit: cover; object-position: right center; filter: brightness(0.98);">
            <div style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(248, 250, 252, 0.3) 0%, transparent 40%); pointer-events: none;"></div>
        </div>

        <!-- Left side floating modern feature card -->
        <div
            style="position: relative; z-index: 10; background: linear-gradient(135deg, #9f1239 0%, #be123c 50%, #e11d48 100%); width: 90%; max-width: 660px; padding: 4rem 4rem 4rem 8%; border-radius: 0 40px 40px 0; box-shadow: 0 25px 60px rgba(159, 18, 57, 0.35); border: 1px solid rgba(255, 255, 255, 0.15); border-left: none;">
            <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255, 255, 255, 0.15); padding: 0.35rem 1rem; border-radius: 50px; color: #fff; font-size: 0.85rem; font-weight: 600; margin-bottom: 1.25rem; letter-spacing: 0.5px; text-transform: uppercase;">
                <i class="fa-solid fa-heart" style="color: #fecdd3;"></i> Our Humanitarian Mission
            </div>
            <h2
                style="font-size: 3rem; font-weight: 800; font-family: var(--font-heading); color: #ffffff; margin-bottom: 1.5rem; line-height: 1.2;">
                हामी हार्ट्स अफ वीरगन्ज हौं <br><span style="font-size: 1.35rem; color: rgba(255, 255, 255, 0.85); font-weight: 500;">(We are Hearts of Birgunj)</span></h2>
            <p style="font-size: 1.2rem; line-height: 1.7; font-weight: 500; color: rgba(255, 255, 255, 0.95); margin: 0;">हामी असहाय, विपन्न, महिला, बालबालिका र युवाहरूलाई सामाजिक सेवा र जनचेतनामार्फत सशक्त बनाउँछौं। <br><em style="color: #fef08a; font-style: normal; font-weight: 700; display: inline-block; margin-top: 0.5rem;">"मानवताको सेवा नै सबैभन्दा ठूलो धर्म हो।"</em></p>
        </div>

        <!-- Circular Icon Button bottom right -->
        <a href="#projects"
            style="position: absolute; bottom: 2.5rem; right: 2.5rem; background: var(--gradient-primary); width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; box-shadow: 0 8px 25px rgba(225, 29, 72, 0.4); transition: transform 0.3s; z-index: 20;"
            onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
            <i class="fa-solid fa-chevron-up" style="color: #ffffff; font-size: 1.2rem;"></i>
        </a>
    </section>

    <!-- Careers and Vacancies Section -->
    <section class="section" id="careers" style="background-color: #f8fafc; padding: 6rem 0; border-top: 1px solid #e2e8f0;">
        <div class="container">
            <div style="background: white; border-radius: 30px; padding: 4rem; box-shadow: 0 15px 45px rgba(15, 23, 42, 0.05); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 3rem; border: 1px solid #f1f5f9;">
                <div style="max-width: 600px; text-align: left;">
                    <span style="color: var(--primary); font-weight: 700; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1.5px; display: block; margin-bottom: 0.8rem; font-family: 'Outfit', sans-serif;">Join Our Organization</span>
                    <h2 style="font-size: 2.8rem; font-weight: 800; font-family: 'Outfit', sans-serif; color: #1e293b; line-height: 1.2; margin-bottom: 1.5rem; margin-top: 0;">रोजगारी अवसरहरू <br><span style="font-size: 1.4rem; color: #64748b;">(Careers & Openings)</span></h2>
                    <p style="font-size: 1.15rem; color: #64748b; line-height: 1.8; margin-bottom: 0;">Hearts of Birgunj एउटा सक्रिय, युवा-नेतृत्वमा आधारित सामाजिक संस्था हो। यदि तपाईंलाई सामाजिक सेवा, मानवता र युवा सशक्तिकरणमा रुचि छ भने, हाम्रो टोलीमा सामेल हुनुहोस्!</p>
                </div>
                
                <div style="background: #0f172a; border-radius: 24px; padding: 2.5rem; color: white; width: 100%; max-width: 400px; box-shadow: 0 20px 40px rgba(15, 23, 42, 0.15); display: flex; flex-direction: column; gap: 1.5rem; text-align: left;">
                    <% if (vacancies.length === 0) { %>
                        <div style="display: flex; align-items: center; gap: 1rem; border-bottom: 1px dashed rgba(255,255,255,0.15); padding-bottom: 1.2rem;">
                            <i class="fa-solid fa-circle-info" style="color: var(--secondary); font-size: 2rem;"></i>
                            <h3 style="margin: 0; font-family: 'Outfit', sans-serif; font-size: 1.4rem; color: var(--secondary);">No Vacancy Available</h3>
                        </div>
                        <p style="margin: 0; font-size: 0.95rem; color: #94a3b8; line-height: 1.6;">We don't have any paid openings at the moment. However, we'd love for you to join us as a volunteer to help create a positive impact!</p>
                        <a href="#" class="btn cta-join" style="background: var(--gradient-primary); color: #ffffff; padding: 0.8rem 1.5rem; border-radius: 12px; font-weight: 700; text-align: center; text-decoration: none; display: block; border: none; font-size: 0.95rem; box-shadow: 0 4px 15px rgba(225, 29, 72, 0.3);">Join as a Volunteer</a>
                    <% } else { %>
                        <div style="display: flex; align-items: center; gap: 1rem; border-bottom: 1px dashed rgba(255,255,255,0.15); padding-bottom: 1.2rem;">
                            <i class="fa-solid fa-circle-check" style="color: #4ade80; font-size: 2rem;"></i>
                            <h3 style="margin: 0; font-family: 'Outfit', sans-serif; font-size: 1.4rem; color: #4ade80;">We Are Hiring!</h3>
                        </div>
                        <div>
                            <span style="font-size: 3rem; font-weight: 800; color: #fbbf24; font-family: 'Outfit', sans-serif; line-height: 1;"><%= vacancies.length %></span>
                            <span style="font-size: 1.1rem; font-weight: 600; color: #f8fafc; display: block; margin-top: 0.2rem;">Open Position(s) Available</span>
                        </div>
                        <p style="margin: 0; font-size: 0.95rem; color: #94a3b8; line-height: 1.6;">We have active paid roles open for passionate changemakers. Reach out to get specific vacancy details and apply.</p>
                        <a href="#" id="getVacancyInfoBtn" style="background: var(--gradient-primary); color: white; padding: 0.8rem 1.5rem; border-radius: 12px; font-weight: 700; text-align: center; text-decoration: none; display: block; font-size: 0.95rem; box-shadow: 0 4px 15px rgba(225, 29, 72, 0.4);">Get Vacancy Info</a>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
        <div class="container text-center">
            <h2>Your Little Step Can Make a Huge Impact!</h2>
            <p>Join us as a volunteer, a partner, or support our causes to bring a positive change in the society.</p>
            <div class="cta-buttons">
                <a href="donate.html" class="btn btn-primary btn-lg">Donate Now</a>
                <a href="#" class="btn btn-secondary btn-lg cta-join">Become a Volunteer</a>
            </div>
        </div>
    </section>

    <!-- Developer Info Banner -->
    <section class="dev-banner" style="background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%); padding: 4.5rem 0; border-top: 1px solid #e2e8f0; position: relative;">
        <div class="container" style="max-width: 900px; margin: 0 auto;">
            <div style="background: #ffffff; border-radius: 28px; padding: 3rem 2.5rem; box-shadow: 0 15px 40px rgba(15, 23, 42, 0.06); border: 1px solid rgba(226, 232, 240, 0.9); display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; overflow: hidden;">
                <!-- Decorative top gradient bar -->
                <div style="position: absolute; top: 0; left: 0; right: 0; height: 5px; background: linear-gradient(90deg, #e11d48, #f59e0b, #0284c7);"></div>

                <!-- Avatar with active indicator -->
                <div style="position: relative; margin-bottom: 1.5rem;">
                    <div style="width: 140px; height: 140px; border-radius: 50%; overflow: hidden; border: 4px solid #ffffff; box-shadow: 0 10px 30px rgba(225, 29, 72, 0.25), 0 0 0 3px #e11d48; transition: transform 0.3s ease;">
                        <img src="/assets/manish.jpg" alt="Manish Kumar Sah" style="width: 100%; height: 100%; object-fit: cover; object-position: center 18%;">
                    </div>
                    <span style="position: absolute; bottom: 4px; right: 8px; width: 22px; height: 22px; background: #22c55e; border: 3px solid #ffffff; border-radius: 50%;" title="Active Developer"></span>
                </div>

                <!-- Developer Title & Bio -->
                <span style="display: inline-block; background: rgba(225, 29, 72, 0.08); color: #be123c; font-size: 0.8rem; font-weight: 700; padding: 0.35rem 1.1rem; border-radius: 50px; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 0.8rem;">
                    <i class="fa-solid fa-code" style="margin-right: 0.4rem;"></i> Website Creator &amp; Tech Partner
                </span>

                <h3 style="margin: 0; font-family: var(--font-heading, 'Outfit', sans-serif); font-size: 1.85rem; font-weight: 800; color: #0f172a;">
                    Designed &amp; Developed by Manish Kumar Sah
                </h3>

                <p style="margin: 0.6rem 0 1.2rem 0; color: #475569; font-size: 1.05rem; font-weight: 500;">
                    <strong style="color: #0f172a;">Founder of Bikrama Technosoft</strong> &bull; Fullstack Web &amp; Mobile Developer
                </p>

                <p style="max-width: 650px; margin: 0 auto 2.2rem auto; color: #64748b; font-size: 0.95rem; line-height: 1.7;">
                    Crafting modern, responsive web experiences and scalable digital platforms for businesses, NGOs, and community organizations with modern performance and design standards.
                </p>

                <!-- Buttons & Contact -->
                <div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1rem;">
                    <a href="/developer.html" class="btn btn-primary" style="padding: 0.75rem 1.8rem; border-radius: 50px; font-weight: 700; font-size: 0.95rem; box-shadow: 0 4px 15px rgba(225, 29, 72, 0.35);">
                        <i class="fa-solid fa-user" style="margin-right: 0.5rem;"></i> View Developer Profile
                    </a>
                    <a href="https://wa.me/9779811807618" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="padding: 0.75rem 1.5rem; border-radius: 50px; font-weight: 600; font-size: 0.95rem; border-color: #22c55e; color: #16a34a; background: rgba(34, 197, 94, 0.05);">
                        <i class="fa-brands fa-whatsapp" style="margin-right: 0.5rem; font-size: 1.1rem; color: #22c55e;"></i> WhatsApp (+977 9811807618)
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer" id="contact">
        <div class="container footer-grid">
            <div class="footer-about">
                <a href="#" class="logo footer-logo">
                    <img src="assets/logo.jpg" alt="Hearts of Birgunj" class="logo-img">
                </a>
                <p>Hearts of Birgunj is dedicated to inspiring change, transforming lives, and fostering resilient
                    communities through active youth participation.</p>
                <div class="social-links">
                    <a href="https://facebook.com/" target="_blank"
                        rel="noopener noreferrer"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="https://twitter.com/" target="_blank" rel="noopener noreferrer"><i
                            class="fa-brands fa-twitter"></i></a>
                    <a href="https://instagram.com/" target="_blank" rel="noopener noreferrer"><i
                            class="fa-brands fa-instagram"></i></a>
                    <a href="https://youtube.com/" target="_blank" rel="noopener noreferrer"><i
                            class="fa-brands fa-youtube"></i></a>
